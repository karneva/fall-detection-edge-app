# Camera
CAM_INDEX=0
CAM_DEVICE=
FRAME_W=1920
FRAME_H=1080
JPEG_QUALITY=80

# YOLO / inference
MODEL_PATH=yolov8s-pose.pt
DEFAULT_CONF=0.50
DETERMINISTIC=1
USE_HALF=0

# Device identity
DEVICE_ID=JETSON-EDGE-001
LOCATION_ID=default-location

# Backend / network
SERVER_URL=https://your-backend.example.com
WS_SERVER_URL=
RPI_URL=http://your-rpi-host:8080/eeum
RPI_SERIAL_NUMBER=RPI-EDGE-001
ESP32_SERIAL_NUMBER=ESP32-EDGE-001

# Integration switches
ENABLE_BACKEND_STREAM=0
ENABLE_SERVER_REPORTING=0
ENABLE_RPI_EVENTS=0
ENABLE_DEVICE_PAIRING=0

# Runtime storage
RUNS_DIR=/app/runs
CLIP_DIR=/app/runs/clips
EVENTS_DIR=/app/runs/events
SAVE_EVENT_SIDECAR=1

# Clip recording
CLIP_FPS=24
CLIP_RESIZE_WIDTH=640
CLIP_RESIZE_HEIGHT=480
CLIP_PRE_SEC=6
CLIP_POST_SEC=6

# Fall detection
ABNORMAL_TIMEOUT_S=10.0

# AI 2nd-stage verifier (veto | shadow | off)
AI_MODE=veto
AI_MODEL_PATH=
AI_SUPPRESS_PFALL_TH=0.4
AI_ESCALATE_S=60.0
AI_ESCALATE_REQUIRES_DROP=1

# EMA smoothing
KP_EMA_ENABLE=1
KP_MIN_CONF=0.30

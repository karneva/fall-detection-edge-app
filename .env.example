# Camera
CAM_INDEX=0
CAM_DEVICE=
FRAME_W=1920
FRAME_H=1080
JPEG_QUALITY=80

# YOLO / inference
MODEL_PATH=yolov8s-pose.pt
DEFAULT_CONF=0.50
# 앞단 개선 (Day 8부터 기본 켜짐, 끄면 Day 7 이전 동작. docs/TUNING_GUIDE.md)
# 사람을 놓친 프레임에서만 영상을 돌려 다시 검출 (누운 사람, 0/1)
ROTATE_FALLBACK=1
# 이 시간(초)보다 짧은 미검출에는 엔진 상태 유지 (0 = 한 프레임만 놓쳐도 초기화)
LOST_GRACE_S=0.5
# 대상 전환: multi = 후보가 2명 이상일 때만 전환, all = IoU가 낮으면 항상 전환
TARGET_SWITCH_POLICY=multi
# LEVEL1 뒤 래치 (기본 꺼짐: 두 번째 낙상을 놓칠 수 있는 경우가 있음, docs/TUNING_GUIDE.md)
POST_ALARM_LATCH=0
DETERMINISTIC=1
USE_HALF=0

# Device identity
DEVICE_ID=JETSON-EDGE-001
LOCATION_ID=default-location

# Backend / network
SERVER_URL=https://your-backend.example.com
WS_SERVER_URL=
RPI_URL=http://your-rpi-host:8080/eeum
RPI_SERIAL_NUMBER=RPI-EDGE-001
ESP32_SERIAL_NUMBER=ESP32-EDGE-001

# Integration switches
ENABLE_BACKEND_STREAM=0
ENABLE_SERVER_REPORTING=0
ENABLE_RPI_EVENTS=0
ENABLE_DEVICE_PAIRING=0

# Runtime storage
RUNS_DIR=/app/runs
CLIP_DIR=/app/runs/clips
EVENTS_DIR=/app/runs/events
SAVE_EVENT_SIDECAR=1

# Clip recording
CLIP_FPS=24
CLIP_RESIZE_WIDTH=640
CLIP_RESIZE_HEIGHT=480
CLIP_PRE_SEC=6
CLIP_POST_SEC=6

# Fall detection
ABNORMAL_TIMEOUT_S=10.0

# AI 2nd-stage verifier (veto | shadow | off)
AI_MODE=veto
AI_MODEL_PATH=
AI_SUPPRESS_PFALL_TH=0.4
AI_ESCALATE_S=60.0
AI_ESCALATE_REQUIRES_DROP=1

# EMA smoothing
KP_EMA_ENABLE=1
KP_MIN_CONF=0.30
